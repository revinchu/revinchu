{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mediprism",
  "main": "build/src/worker.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["python_workers"],
  // /static/* 는 Worker를 거치지 않고 정적 자산으로 바로 서빙
  "assets": { "directory": "build/public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mediprism",
      // `npx wrangler d1 create mediprism` 결과의 database_id 로 교체
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  // 10분마다 SLA(30분) 초과 미응대 문의 알림
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    "BRAND_NAME": "MEDIPRISM",
    "MAIL_BACKEND": "resend"
  },
  "observability": { "enabled": true }
}
